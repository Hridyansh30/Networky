# Where the "Open workspace" buttons point. Must be https in production
# (http is allowed only on localhost). Copy to .env.local for local overrides.
VITE_WORKSPACE_URL=https://app.example.com/

# Optional. Where THIS landing page is deployed. When set, the build adds
# link-preview tags (og:image, og:url) with absolute URLs, so a shared link
# shows the preview card. Same rules: https only.
# VITE_SITE_URL=https://networky.example.com/
